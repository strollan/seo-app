#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="$HOME/.local/state/leadme-bg"
latest_log="$(ls -1t "$STATE_DIR"/*.log 2>/dev/null | head -n 1 || true)"

if [[ -z "$latest_log" ]]; then
  echo "No LeadMe background runs found."
  exit 0
fi

base="${latest_log%.log}"
pid_file="$base.pid"
result_file="$base.result"

echo "LATEST LEADME BACKGROUND RUN"
echo "  log: $latest_log"

if [[ -f "$result_file" ]]; then
  echo "  status: FINISHED"
elif [[ -f "$pid_file" ]]; then
  pid="$(cat "$pid_file")"
  if kill -0 "$pid" 2>/dev/null; then
    echo "  status: RUNNING"
    echo "  pid: $pid"
  else
    echo "  status: STOPPED"
  fi
fi

if [[ -f "$result_file" ]]; then
  echo
  cat "$result_file"
fi

echo
echo "===== LAST 35 LOG LINES ====="
tail -n 35 "$latest_log"
