# Copy this to .env locally or set these in your web host environment.
# Do NOT put real secrets in this example file.

# === OpenAI ===
OPENAI_API_KEY=

# === LeadBot SERP provider ===
# Recommended production:
# LEADBOT_SERP_PROVIDER=dataforseo
LEADBOT_SERP_PROVIDER=dataforseo
USE_LIVE_SERP=1

# === DataForSEO ===
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_ENABLED=1
LEADBOT_DATAFORSEO_ENABLED=1
DATAFORSEO_MODE=organic
DATAFORSEO_DEPTH=60
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEVICE=desktop
DATAFORSEO_OS=windows
LEADBOT_ORGANIC_ONLY=1

# === Google / fallback APIs ===
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=

# Keep Places disabled for main LeadBot scans if you want organic SERP-first leads.
LEADBOT_DISABLE_PLACES_MAIN=1

# === Cookies / production security ===
# Local dev over plain http:// can leave this false.
# REQUIRED in production: the real production .env must contain
# APP_COOKIE_SECURE=true once the site is served over HTTPS, or the login
# session cookie will be sent without the Secure flag. See docs/leadme-deploy.md.
APP_COOKIE_SECURE=true

# === Password reset / email ===
# Mail is sent over the Resend HTTPS API (agents/email_agent.py), not SMTP --
# outbound SMTP ports (25/465/587) are blocked from the production droplet.
# Set RESEND_API_KEY and SMTP_FROM in production to enable real email
# delivery. SMTP_FROM must be an address on a domain verified in Resend.
APP_BASE_URL=https://leadmeleads.com
RESEND_API_KEY=
SMTP_FROM=no-reply@leadmeleads.com
# SMTP_HOST/PORT/USER/PASSWORD are no longer used to send mail (kept only
# because _is_dev_mode() still keys off SMTP_HOST being set/unset).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === Contact / report form ===
# Destination for reports submitted via /contact. Falls back to SMTP_FROM
# when unset. Uses the same Resend sender configured above -- no separate
# mail provider.
CONTACT_REPORT_EMAIL=support@leadmeleads.com

# === Dev reset link (local only) ===
# Set to 1 in your LOCAL .env to show the reset link on-screen and in the console.
# MUST be 0 or unset in production — the link is NEVER shown unless this is explicitly 1.
# When unset (default), no reset link is printed or displayed, even if SMTP is not configured.
SHOW_DEV_RESET_LINK=0
